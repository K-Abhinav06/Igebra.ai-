################################################################################
# EduAI - Environment Configuration
# Copy this file to .env.local and update with your actual credentials
# IMPORTANT: Never commit .env.local to version control
################################################################################

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB Connection String
# 
# SETUP INSTRUCTIONS:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create a free account (if you don't have one)
# 3. Create a new project and cluster
# 4. Click "Connect" and select "Drivers"
# 5. Copy the connection string
# 6. Replace <username> and <password> with your MongoDB credentials
# 7. Replace <cluster-name> with your actual cluster name
#
# FORMAT: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority
#
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eduai?retryWrites=true&w=majority

# ============================================================================
# AI PROVIDER KEYS
# ============================================================================

# GROQ API Key (Fast LLM Inference)
#
# SETUP INSTRUCTIONS:
# 1. Visit https://console.groq.com
# 2. Sign up for a free account
# 3. Go to API Keys section
# 4. Create a new API key
# 5. Copy the key and paste it below
#
# Used for: Fast LLM inference for tutoring and quiz generation
#
GROQ_API_KEY=your_groq_api_key_here

# Google Generative AI API Key (Gemini)
#
# SETUP INSTRUCTIONS:
# 1. Go to https://makersuite.google.com/app/apikey
# 2. Create a new API key
# 3. Copy the key and paste it below
#
# Used for: Advanced AI capabilities for content generation
#
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application Display Name
NEXT_PUBLIC_APP_NAME=EduAI

# Application Base URL
# Used for redirects, links, and API endpoints
# IMPORTANT: Change to your production URL when deploying
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# AUTHENTICATION (OPTIONAL)
# ============================================================================

# NextAuth Secret - For session encryption
#
# SETUP INSTRUCTIONS:
# Generate a random secret using:
# - Windows PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# - Linux/Mac: openssl rand -base64 32
#
# This is optional but recommended for production deployments
#
NEXTAUTH_SECRET=your_random_secret_here_generate_with_openssl_rand_base64_32

# NextAuth URL
# Must match your application URL
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# LOGGING & DEBUG (OPTIONAL)
# ============================================================================

# Enable debug mode (set to "true" for development)
DEBUG=false

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================================================
# FEATURES (OPTIONAL)
# ============================================================================

# Enable AI features (set to false to use mock responses)
ENABLE_AI_FEATURES=true

# Maximum tokens for AI responses
MAX_AI_TOKENS=2000

# Quiz difficulty levels available
QUIZ_DIFFICULTY_LEVELS=easy,medium,hard

# ============================================================================
# NOTES
# ============================================================================
#
# - Keep this file (.env.local) in .gitignore - NEVER commit real credentials
# - For production, use environment variables in your hosting platform
# - All "NEXT_PUBLIC_" variables are exposed to the browser - don't put secrets there
# - Missing environment variables may cause the app to fail or fall back to mock data
#
################################################################################

